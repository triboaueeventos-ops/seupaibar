}

async function salvarClique(tipo, extra){
  try {
    await fetch('/api/registrar', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ tipo, dispositivo: dispositivo(), extra: extra || null })
    });
  } catch(e){}
}

// Rastrear cliques nos botões de WhatsApp (hero + urgência + rodapé)
document.addEventListener('DOMContentLoaded', function(){
  document.querySelectorAll('a[href*="wa.me"]').forEach(function(el){
    el.addEventListener('click', function(){
      salvarClique('whatsapp_botao');
    });
  });
});

// ── Formulário de Reserva ─────────────────────────────────
async function enviarReserva(){
  var nome=document.getElementById('f-nome').value.trim();
  var wpp=document.getElementById('f-wpp').value.trim();
  var pessoas=document.getElementById('f-pessoas').value;
  var data=document.getElementById('f-data').value;
  var obs=document.getElementById('f-obs').value.trim();
  if(!nome||!wpp||!pessoas||!data){alert('Por favor, preencha todos os campos obrigatórios.');return;}

  // Salvar clique
  await salvarClique('reserva_formulario', nome + ' | ' + wpp + ' | ' + pessoas + ' pessoas | ' + data);

  var dataFmt=data?new Date(data+'T12:00:00').toLocaleDateString('pt-BR'):'';
  var msg='Ol%C3%A1!%20Quero%20reservar%20uma%20mesa%20para%20o%20Happy%20Hour%20do%20Seu%20Pai%20Bar%20Drinkeria.%20%F0%9F%92%99%0A%0A';
  msg+='%F0%9F%91%A4%20Nome%3A%20'+encodeURIComponent(nome)+'%0A';
  msg+='%F0%9F%93%B1%20WhatsApp%3A%20'+encodeURIComponent(wpp)+'%0A';
  msg+='%F0%9F%91%A5%20Pessoas%3A%20'+encodeURIComponent(pessoas)+'%0A';
  msg+='%F0%9F%93%85%20Data%3A%20'+encodeURIComponent(dataFmt)+'%0A';
  if(obs)msg+='%F0%9F%93%9D%20Obs%3A%20'+encodeURIComponent(obs);
  window.open('https://wa.me/553136572609?text='+msg,'_blank');
}
</script>
